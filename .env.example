# Commission Escrow standalone — environment variables.
# NAMES AND NOTES ONLY. Copy to .env locally (never commit a filled copy),
# or set the same names in the Render dashboard.

# --- Database ---
# Postgres connection string. On Render: the Internal Database URL of the
# free Postgres — created LAST, manually (see DEPLOY.md). Locally, leave
# unset to use the embedded PGlite database instead.
DATABASE_URL=

# --- Runtime ---
NODE_ENV=            # "production" on Render (enables the __Host- cookie)
PORT=                # Render sets this automatically; locally defaults to 3000
PUBLIC_BASE_URL=     # optional: the public site URL, for reference/logging
APP_ORIGIN=          # optional: exact Origin value to accept besides the host itself

# --- Owner bootstrap ---
# The email address whose account is born with the dev role (no invite
# code needed, exactly one address, compared case-insensitively).
# FAILS CLOSED: when unset, nobody is dev and every signup needs a code.
OWNER_EMAIL=

# --- Secrets ---
# Signs the CSRF tokens (HMAC). Required in production; use a long random
# value and keep it stable across deploys (changing it logs nobody out,
# but invalidates outstanding anonymous CSRF tokens).
APP_ENCRYPTION_KEY=
# SESSION_SECRET=    # optional fallback for APP_ENCRYPTION_KEY

# --- Cookies ---
COOKIE_SECURE=       # "1" in production: session cookie becomes __Host-ce_session + Secure

# --- Object storage ---
STORAGE_DRIVER=      # "local" (default) or "s3"
STORAGE_DIR=         # local driver root (default ./storage-data)
S3_ENDPOINT=         # s3 driver: e.g. https://<account-id>.r2.cloudflarestorage.com
S3_REGION=           # s3 driver: "auto" for Cloudflare R2
S3_BUCKET=           # s3 driver: the PRIVATE bucket name
S3_ACCESS_KEY_ID=    # s3 driver credential
S3_SECRET_ACCESS_KEY= # s3 driver credential

# --- Behaviour switches ---
RUN_MIGRATIONS=      # "0" disables boot-time migrations (default: run them)
CLIENT_DIR=          # optional override for the built client directory
PGLITE_DIR=          # local-only: PGlite data dir (default ./.pglite-data)
